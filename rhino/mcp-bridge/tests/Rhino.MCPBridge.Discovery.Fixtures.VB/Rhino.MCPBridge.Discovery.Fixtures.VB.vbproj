<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A Visual Basic fixture, deliberately (issue #186, ported from the Revit connector). Discovery has to
    render and resolve NAMED indexed properties, a C++/CLI shape C# cannot declare: a C# indexer is always
    the type's DefaultMember whatever [IndexerName] calls it, so no C# fixture can produce the non-default
    case. VB declares them natively (`Property SlopeAngle(curve As Integer) As Double`), so this stays a
    portable tier-1 fixture. Test-only; never shipped.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Rhino.MCPBridge.Discovery.Fixtures.VB</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Same convention as the C# fixtures: a real XML-doc sidecar next to the DLL, which
         DiscoveryReflector finds via Path.ChangeExtension(assembly.Location, ".xml"). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
