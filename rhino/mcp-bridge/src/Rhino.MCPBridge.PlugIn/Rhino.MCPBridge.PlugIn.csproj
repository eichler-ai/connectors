<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Rhino plug-in (.rhp): PlugIn subclass, listener thread, commands. Composition only; no
       decision logic (that lives in Core, tested). -->
  <PropertyGroup>
    <TargetFramework>$(BridgeTargetFramework)</TargetFramework>
    <RootNamespace>Rhino.MCPBridge.PlugIn</RootNamespace>
    <AssemblyName>Rhino.MCPBridge.PlugIn</AssemblyName>
    <TargetExt>.rhp</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <InformationalVersion>$(BridgeVersion)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="$(RhinoCommonVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <ProjectReference Include="../Rhino.MCPBridge.Core/Rhino.MCPBridge.Core.csproj" />
    <ProjectReference Include="../Rhino.MCPBridge.RhinoAdapter/Rhino.MCPBridge.RhinoAdapter.csproj" />
  </ItemGroup>

  <!-- API discovery (PRD §09): SQLitePCLRaw's native e_sqlite3 resolver checks the loading assembly's own
       directory, but under Rhino's LoadFrom-style plug-in load it does NOT walk runtimes/<rid>/native/
       (the same finding the Revit connector hit). Flatten the platform-correct native beside the managed
       DLLs so the resolver finds it. On Windows always win-x64 (Rhino 8 is x64, incl. under ARM64
       emulation); on macOS the SDK's own RID (arm64 or x64 build host == the Rhino it deploys to). -->
  <Target Name="FlattenSqliteNative" AfterTargets="Build" Condition="'$(TargetFramework)'!=''">
    <Copy SourceFiles="$(TargetDir)runtimes/win-x64/native/e_sqlite3.dll" DestinationFolder="$(TargetDir)"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('$(TargetDir)runtimes/win-x64/native/e_sqlite3.dll')" />
    <Copy SourceFiles="$(TargetDir)runtimes/$(NETCoreSdkRuntimeIdentifier)/native/libe_sqlite3.dylib" DestinationFolder="$(TargetDir)"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) And Exists('$(TargetDir)runtimes/$(NETCoreSdkRuntimeIdentifier)/native/libe_sqlite3.dylib')" />
  </Target>
</Project>
