<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- See MCPBridge.RevitAdapter.csproj for the multi-target rationale and per-version .NET
         requirements (PRD §11). This assembly must build for every TFM MCPBridge.Core does, since
         Core references it. -->
    <TargetFrameworks>net10.0-windows;net8.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Eichler.Connectors.Revit</RootNamespace>
    <AssemblyName>Eichler.Connectors.Revit</AssemblyName>

    <!--
      LOAD-BEARING, not hygiene: DiscoveryReflector joins each synced assembly against its XML-doc
      sidecar, and its no-sidecar escape hatch defaults `documented` to true when there is no .xml file
      at all. Without this property the connector's own API would sync as bare signatures with empty
      summaries ; a strictly worse product than get_skills, and the exact outcome issue #91 exists to
      avoid. The sidecar reaches Revit's Addins folder because MSBuild's default
      AllowedReferenceRelatedFileExtensions copies a ProjectReference's .xml alongside its .dll.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591 ("missing XML comment for publicly visible type or member") is an ERROR here and nowhere
      else in this solution. This assembly's public surface IS the agent-facing documentation: an
      undocumented member reaches describe_function as a bare signature. Making it a build failure is
      the cheapest possible version of issue #91's requirement 1 ("one source of truth, everything else
      tested against it") ; a compile-time fact rather than a review habit.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <!-- Revit-version mapping, mirroring MCPBridge.RevitAdapter.csproj (PRD §11). -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-windows'">
    <RevitVersion>2027</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <RevitVersion>2025</RevitVersion>
  </PropertyGroup>
  <PropertyGroup>
    <RevitInstallDir>C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallDir>
  </PropertyGroup>

  <!--
    This assembly names Autodesk.Revit.DB.Document directly, and that is now a property of WHICH
    ASSEMBLY YOU ARE IN rather than a comment asking people not to. Before issue #91, ScriptGlobals.cs
    carried the whole burden: MCPBridge.Core.csproj referenced RevitAPI "for one file", and that file's
    own doc comment had to plead "do not reach for them from anywhere else in Core." The document-facing
    half of the script API lives here now, so the exception has a boundary.

    Private=false matches every other project here: inside a live Revit process RevitAPI/RevitAPIUI are
    already loaded, so copying them next to the add-in would only risk shadowing Revit's own copies.
  -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    IConnectorRuntime is internal: it is the seam MCPBridge.Core implements, and it must not appear in
    this assembly's PUBLIC surface, because that surface is exactly what an agent sees. DiscoveryReflector
    filters on IsPubliclyVisible, so "Connector is the only type an agent can discover here" is a
    compile-time fact, not a filter someone has to remember to maintain.

    Note what this grant does NOT do: it points OUTWARD only (this assembly -> Core), so the reference
    graph stays one-directional. Core references this project; this project references nothing of Core's.
    That is the whole reason the facade exists rather than the seven members being physically moved ;
    moving them would drag ManagedDocumentTransactions and PublishedFileRecord down a layer with them.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MCPBridge.Core</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MCPBridge.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
