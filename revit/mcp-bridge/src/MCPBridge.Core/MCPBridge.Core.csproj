<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted even though Core has no Revit-version-specific logic of its own: it references
         MCPBridge.RevitAdapter (now itself multi-targeted, PRD §11), and a ProjectReference's TFM must be
         compatible with the referencing project's ;AddIn's net8.0-windows leg needs a net8.0-windows
         build of Core to link against, not just net10.0-windows. -->
    <TargetFrameworks>net10.0-windows;net8.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MCPBridge.Core</RootNamespace>
    <AssemblyName>MCPBridge.Core</AssemblyName>
  </PropertyGroup>

  <!-- Revit-version mapping, mirroring MCPBridge.RevitAdapter.csproj (PRD §11). -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-windows'">
    <RevitVersion>2027</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <RevitVersion>2025</RevitVersion>
  </PropertyGroup>
  <PropertyGroup>
    <RevitInstallDir>C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallDir>
  </PropertyGroup>

  <!--
    A deliberate, narrow exception to Core's Revit-decoupling, scoped to ONE file: ScriptGlobals.cs.
    Phase 3 (PRD §14) makes the script-facing globals the REAL Autodesk.Revit.DB.Document /
    Autodesk.Revit.UI.UIApplication / UIDocument, and ScriptGlobals is inherently the public
    script-facing contract ; it has to name those types now that scripts bind to them. Everything
    else in Core stays exactly as decoupled as before, behind the MCPBridge.RevitAdapter interfaces.
    This is NOT a precedent for the rest of Core; see ScriptGlobals.cs's own doc comment.

    Private=false matches RevitAdapter: inside a live Revit process RevitAPI/RevitAPIUI are already
    loaded, so copying them next to the add-in would only risk shadowing Revit's own copies.
  -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.11.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <!-- Pin past SQLitePCLRaw 2.1.10, which Microsoft.Data.Sqlite 9.0.0 otherwise transitively pulls in
         and which has a known high-severity CVE (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MCPBridge.RevitAdapter\MCPBridge.RevitAdapter.csproj" />
    <!-- The connector's own script-facing API (issue #91). A ONE-DIRECTIONAL reference: that assembly
         knows nothing of Core, which is what lets ScriptGlobals implement its IConnectorRuntime seam
         without a cycle. See Eichler.Connectors.Revit.csproj for why it is a separate assembly at all
         (short version: DiscoveryReflector syncs publicly visible types, and Core has 71 of them). -->
    <ProjectReference Include="..\Eichler.Connectors.Revit\Eichler.Connectors.Revit.csproj" />
  </ItemGroup>

  <!--
    ManagedDocumentTransactions, ExternalEventBridge, TransactionScriptExecutor, ScriptGlobals'
    constructor and RequestDispatcher's constructor are internal because they are reachable from agent
    script scope otherwise ; RoslynScriptRunner.LoadableReferences() references every assembly loaded in
    the Revit AppDomain, this one included, so a public transaction-owning type here (or a public type
    that HANDS OUT one, including through a caller-supplied callback ; see RevitScriptExecutionHandler)
    is a capability an untrusted script can reach. See ManagedDocumentTransactions' own doc comment for
    the live evidence. These grants let MCPBridge.Core.Tests keep testing them directly and let
    MCPBridge.AddIn keep wiring them together in BridgeHost ; a Roslyn script submission assembly is
    never named here and cannot choose its own name, so it gains nothing.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MCPBridge.Core.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MCPBridge.AddIn</_Parameter1>
    </AssemblyAttribute>
    <!--
      IdentifierRelevance (search_functions' tier-2 ranking, issue #65) is a pure scoring function with no
      capability attached, but it stays internal under this assembly's default-to-internal rule rather than
      being made public just to be testable. Its behaviour is a set of weighted numeric judgments, which is
      exactly the kind of thing that wants direct unit tests over the scorer itself rather than only
      end-to-end assertions through DiscoveryCache.Search.
    -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MCPBridge.Discovery.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
