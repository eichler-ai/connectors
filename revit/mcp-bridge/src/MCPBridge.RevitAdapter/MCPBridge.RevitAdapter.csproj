<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Multi-target structure per PRD §11: the plural <TargetFrameworks> element
      (rather than singular) was used deliberately from v1 onward so that
      adding 2025/2026 support later is a matter of adding TFM entries, not
      restructuring the project ;this is that step for 2025.

      Per-version .NET requirements, both confirmed live against the actual
      installed products on the dev VM (PRD §11), not assumed: Revit 2027's
      RevitAPI.dll/RevitAPIUI.dll (27.0.4.0) references System.Runtime
      10.0.0.0 and requires net10.0-windows ;compiling it under
      net8.0-windows fails with a hard, non-suppressible CS1705. Revit 2025's
      RevitAPI.runtimeconfig.json instead declares "tfm": "net8.0", and does
      build cleanly under net8.0-windows (derisked with a live spike before
      this project change: the single .NET 10 SDK already on this VM
      cross-targets net8.0-windows against the real 2025 RevitAPI.dll with 0
      errors ;no second SDK needed, deliberately, per this project's
      standing "exactly one SDK on the VM" rule). 2026 remains unverified;
      don't assume it matches 2025 without checking the same way.
    -->
    <TargetFrameworks>net10.0-windows;net8.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MCPBridge.RevitAdapter</RootNamespace>
    <AssemblyName>MCPBridge.RevitAdapter</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-windows'">
    <RevitVersion>2027</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <RevitVersion>2025</RevitVersion>
  </PropertyGroup>
  <PropertyGroup>
    <RevitInstallDir>C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
