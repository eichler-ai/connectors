<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- See MCPBridge.RevitAdapter.csproj for the multi-target rationale (PRD §11). -->
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MCPBridge.AddIn</RootNamespace>
    <AssemblyName>MCPBridge.AddIn</AssemblyName>
    <UseWindowsForms>false</UseWindowsForms>
    <!-- For MCPBridgeStatusWindow: a non-modal status display (a real WPF Window shown via .Show(), not
         .ShowDialog()/TaskDialog.Show()) so it never blocks Revit's UI thread the way a modal would;
         load-bearing for both UX (doesn't force-interrupt the user's work to dismiss it) and for this
         add-in's own live self-testing (a modal here would deadlock: closing it needs the same UI thread
         a follow-up execute_script call also needs). -->
    <UseWPF>true</UseWPF>
    <RevitVersion>2027</RevitVersion>
    <RevitInstallDir>C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallDir>
    <!--
      Not the PRD §12 production signing plan (a CA-issued, publicly-trusted, timestamped cert for
      signed-installer distribution; still phase 05, still not done here). This is dev-loop convenience
      only: a self-signed cert trusted on THIS machine (see tools\New-DevSigningCert.ps1) eliminates
      Revit's "unverified publisher, Load Once/Always Load/Do Not Load" prompt on every rebuild during
      iterative live testing, where that prompt was real, repeated friction (every DLL content change
      re-triggers it, since Revit's own per-file trust decision is keyed by content, not just publisher;
      signing sidesteps that by making the publisher itself verified, not the specific file). Opt out with
      -p:MCPBridgeSignDevBuild=false (e.g. CI, or a machine without the dev cert set up); though that
      shouldn't usually be necessary: Sign-AddIn.ps1 itself treats "no cert configured" as an intentionally
      supported unsigned-build mode (exits 0, just prints a note) rather than an error, so a fresh checkout
      without the dev cert set up still builds fine unsigned with no opt-out needed. What DOES fail the
      build (deliberately, per independent PR review; a prior version of this target used
      ContinueOnError="WarnAndContinue" unconditionally, which would have silently warned away a genuine
      signing bug indefinitely) is a cert that WAS found but a real signing attempt that then failed.
    -->
    <MCPBridgeSignDevBuild Condition="'$(MCPBridgeSignDevBuild)'==''">true</MCPBridgeSignDevBuild>
    <!--
      Revit loads this DLL directly out of its Addins folder: there is no "dotnet publish" style
      deployment step doing dependency flattening for us, and this is a plugin, not a standalone app, so
      a plain "dotnet build" output isn't enough. Build only copies THIS project's own direct output plus
      its ProjectReferences, never a ProjectReference's own *transitive* NuGet package dependencies
      (e.g. MCPBridge.Core's Microsoft.CodeAnalysis.CSharp.Scripting and friends, i.e. Roslyn). Without
      them physically present next to MCPBridge.AddIn.dll, the CLR's default probing (which only looks in
      the app's base directory when there's no host-provided resolution, as is the case for a raw
      Assembly.LoadFrom style plugin load) can't find them, and depending on exactly when/how that
      failure surfaces, Revit can silently fail to even construct MCPBridgeApplication: no exception
      visible anywhere, no add-in security prompt, nothing. OnStartup is simply never reached. Confirmed
      via live-wiring validation (first live-Revit test session): the build output was missing the Roslyn
      DLLs entirely, and copying only MCPBridge.*.dll to the Addins folder reproduced exactly that
      silent-no-load symptom. CopyLocalLockFileAssemblies makes `dotnet build` behave like `publish` for
      this purpose, copying every resolved dependency (including transitive ones) into the output folder,
      so a straightforward folder copy of bin\Release\net10.0-windows\ is actually deployable.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MCPBridge.Core\MCPBridge.Core.csproj" />
    <ProjectReference Include="..\MCPBridge.RevitAdapter\MCPBridge.RevitAdapter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="MCPBridge.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Signs the built DLL with the local dev cert immediately after Build, so a plain folder copy of the
    output (the deploy step this project uses; see the revit-connector-development skill) is already
    signed. Deliberately NOT ContinueOnError: Sign-AddIn.ps1 itself exits 0 (not an error) for the "no
    cert configured on this machine" case, so a genuine non-zero exit here means a cert WAS found and a
    real signing attempt actually failed; that should fail the build loudly, not be warned away forever
    (independent PR review finding on an earlier version of this target).

    TargetFrameworks (plural, see the multi-target comment above) means this project builds via an outer
    cross-targeting orchestration pass plus one inner per-TargetFramework pass; AfterTargets="Build" fires
    on BOTH, but $(TargetPath) is only populated in the inner one; the '$(TargetFramework)' != '' guard
    keeps this from running (and failing on an empty -DllPath) in the outer pass.
  -->
  <Target Name="MCPBridgeSignDevBuild" AfterTargets="Build" Condition="'$(MCPBridgeSignDevBuild)'=='true' And '$(OS)'=='Windows_NT' And '$(TargetFramework)'!=''">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\Sign-AddIn.ps1&quot; -DllPath &quot;$(TargetPath)&quot;" />
  </Target>

  <!--
    Embeds the current git commit into the assembly (read by MCPBridgeStatusCommand's ribbon-button
    dialog, via AssemblyMetadataAttribute) so "which build is this" can be answered from inside Revit, not
    just from a log file or by cross-referencing a build timestamp against git log.

    Independent PR review finding: an earlier version used BeforeTargets="GenerateAssemblyInfo", which
    never actually worked; MSBuild's real order is DependsOnTargets, then BeforeTargets, then the
    target's own body, and GenerateAssemblyInfo's DependsOnTargets chain (via CoreGenerateAssemblyInfo)
    already runs GetAssemblyAttributes, the target that actually converts @(AssemblyMetadata) items into
    @(AssemblyAttribute), before GenerateAssemblyInfo's own BeforeTargets hook ever fires. The
    AssemblyMetadata item this target adds was therefore always too late to be picked up; the button
    always showed "Commit: unknown" regardless of whether git was even available. Masked on the dev VM
    itself specifically because it has no git installed, so the bug and the intended graceful degradation
    looked identical from the UI. BeforeTargets="GetAssemblyAttributes" is the actually-correct hook.

    Second finding: ConsoleToMSBuild="true" captures BOTH stdout and stderr into ConsoleOutput, so a git
    failure that writes to stderr (plausible here: SYSTEM-context builds over a UNC/mapped shared drive
    path routinely trip git's "detected dubious ownership" safe-directory check) would embed the literal
    "fatal: ..." message as the commit string instead of leaving it empty. IgnoreExitCode +
    checking $(MCPBridgeGitExitCode)=='0' before using the captured value fixes this: only a genuinely
    successful `git rev-parse` populates AssemblyMetadata at all.
  -->
  <!--
    Microsoft.Data.Sqlite (MCPBridge.Core.csproj) resolves its native e_sqlite3.dll via SQLitePCLRaw's own
    runtime probing, which expects the standard NuGet "runtimes\<rid>\native\" layout relative to the
    loading assembly's directory. That layout survives a normal `dotnet publish`, but this project deploys
    by folder-copying `dotnet build` output straight into Revit's Addins folder (see
    CopyLocalLockFileAssemblies's own doc comment above for why a plain build, not publish, is what actually
    ships here); and more specifically, Revit loads this add-in via its own AddInLoader, an
    Assembly.LoadFrom-style plugin load with no deps.json-driven host resolution behind it. Confirmed via a
    live spike inside a real Revit process: SQLitePCLRaw's native resolver simply does not find
    runtimes\win-x64\native\e_sqlite3.dll under that load model, even though the file is physically present
    (CopyLocalLockFileAssemblies already copies it there); opening a SqliteConnection throws a
    DllNotFoundException. Flattening the native DLL into the same directory as the managed DLLs (which
    SQLitePCLRaw's resolver DOES check) fixes this; Condition on the source existing so a build that doesn't
    pull in Microsoft.Data.Sqlite/SQLitePCLRaw.bundle_e_sqlite3 at all (e.g. a future test-only config)
    doesn't fail over a file that was never going to exist.
  -->
  <Target Name="MCPBridgeFlattenSqliteNative" AfterTargets="Build" Condition="'$(TargetFramework)'!=''">
    <Copy
      SourceFiles="$(TargetDir)runtimes\win-x64\native\e_sqlite3.dll"
      DestinationFolder="$(TargetDir)"
      Condition="Exists('$(TargetDir)runtimes\win-x64\native\e_sqlite3.dll')" />
  </Target>

  <Target Name="MCPBridgeEmbedGitCommit" BeforeTargets="GetAssemblyAttributes" Condition="'$(TargetFramework)'!=''">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="MCPBridgeGitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="MCPBridgeGitExitCode" />
    </Exec>
    <ItemGroup Condition="'$(MCPBridgeGitExitCode)'=='0' And '$(MCPBridgeGitCommit)'!=''">
      <AssemblyMetadata Include="GitCommit" Value="$(MCPBridgeGitCommit)" />
    </ItemGroup>
  </Target>

</Project>
