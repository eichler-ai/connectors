<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Deliberately NOT multi-targeted, unlike the other two test projects. The reason is ONLY the
         second one below ; the first would not distinguish this project at all:
           - NOT "it would need a Revit 2025 install to build". True, but equally true of
             MCPBridge.Core.Tests and MCPBridge.Discovery.Tests now that they multi-target: both
             reference MCPBridge.RevitAdapter, whose net8 leg hard-codes a HintPath into
             "C:\Program Files\Autodesk\Revit 2025". The dev-loop `dotnet test` genuinely gained a
             Revit-2025 build dependency in this PR; that is a real cost, accepted knowingly, not a
             property unique to this project.
           - It is a tier-2 project (see the revit-connector-development skill): an empty shell that
             needs a live Revit session, and is not run in the `dotnet test` dev loop at all. A second
             TFM here would add build surface for a suite nothing executes. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>MCPBridge.Integration.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Empty shell for now: needs a live Revit session driven by
      revit/test-harness/ (tier 2, see the revit-connector-development skill).
      Not run as part of the normal `dotnet test` dev loop.
    -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MCPBridge.Core\MCPBridge.Core.csproj" />
    <ProjectReference Include="..\..\src\MCPBridge.RevitAdapter\MCPBridge.RevitAdapter.csproj" />
    <ProjectReference Include="..\..\src\MCPBridge.AddIn\MCPBridge.AddIn.csproj" />
  </ItemGroup>

</Project>
