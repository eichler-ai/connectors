<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Deliberately NOT multi-targeted, unlike the other two test projects: this one references
         MCPBridge.AddIn, whose net8.0-windows leg links against Revit 2025's own assemblies, so a
         net8 build here would need a 2025 install present just to compile an empty shell. It is a
         tier-2 project that needs a live Revit session anyway (see the revit-connector-development
         skill) and is not part of the `dotnet test` dev loop, so multi-targeting it would add a build
         dependency without adding any coverage. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>MCPBridge.Integration.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Empty shell for now: needs a live Revit session driven by
      revit/test-harness/ (tier 2, see the revit-connector-development skill).
      Not run as part of the normal `dotnet test` dev loop.
    -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MCPBridge.Core\MCPBridge.Core.csproj" />
    <ProjectReference Include="..\..\src\MCPBridge.RevitAdapter\MCPBridge.RevitAdapter.csproj" />
    <ProjectReference Include="..\..\src\MCPBridge.AddIn\MCPBridge.AddIn.csproj" />
  </ItemGroup>

</Project>
