  <members>
    <member name="T:Sample.Widget">
      <summary>
        A sample widget type, for XmlDocIndex parsing tests.
      </summary>
    </member>
    <member name="M:Sample.Widget.#ctor(System.Int32)">
      <summary>Creates a widget with the given id.</summary>
      <param name="id">The widget's id.</param>
    </member>
    <member name="M:Sample.Widget.Describe(System.Int32)">
      <summary>
        Describes the widget
        across multiple lines
        of indented text.
      </summary>
      <param name="detailLevel">How much detail to include.</param>
      <returns>A textual description.</returns>
    </member>
    <member name="P:Sample.Widget.Id">
      <summary>The widget's id.</summary>
    </member>
    <!--
      Two consecutive <para> blocks separated ONLY by a newline and indentation, which is exactly what
      the C# compiler emits and what Revit's own RevitAPI.xml contains. Shaped this way deliberately:
      XDocument's default load drops whitespace-only text nodes between sibling elements, so this
      rendered as "...first block.Second block..." in real describe_function output until
      LoadOptions.PreserveWhitespace was passed. A fixture with any non-whitespace character between
      the paragraphs would pass either way and prove nothing.
    -->
    <member name="M:Sample.Widget.Explain">
      <summary>
        Leading prose before any block element.
        <para>First paragraph, whose last word must not run into the next.</para>
        <para>Second paragraph.</para>
      </summary>
    </member>
    <!--
      The same two paragraphs with NO whitespace between them at all, which is what a tool-generated
      sidecar can emit. LoadOptions.PreserveWhitespace cannot fix this one ; there is no whitespace node
      to preserve ; so it is what pins the block-element separator injected in AppendText. Review found
      the PR's first fix handled only the indented case while its test name claimed the general property.
    -->
    <member name="M:Sample.Widget.ExplainUnindented">
      <summary><para>First paragraph.</para><para>Second paragraph.</para></summary>
    </member>
  </members>
