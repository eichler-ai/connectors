<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted for the same reason as MCPBridge.Core.Tests: the net8.0-windows leg had no
         automated coverage at all. The discovery reflection path is TFM-sensitive in a way the rest of
         Core isn't ; it reflects over a real assembly and its XML-doc sidecar ; so running it on both
         legs is worth more here than almost anywhere else. -->
    <TargetFrameworks>net10.0-windows;net8.0-windows</TargetFrameworks>
    <!-- Same reason as MCPBridge.Core.Tests: the VM has one .NET install (10) and cannot run a net8.0
         test host without it. See that project's fuller note, including the fidelity caveat. -->
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>MCPBridge.Discovery.Tests</RootNamespace>
    <!--
      Emits a real XML-doc sidecar (MCPBridge.Discovery.Tests.xml) next to this test assembly's own DLL,
      compiled from the Fixtures/*.cs triple-slash comments; DiscoveryServiceTests/DiscoveryCacheTests sync a
      DiscoveryCache against typeof(Fixtures.Widget).Assembly (this assembly), and DiscoveryReflector locates
      this file via the same Path.ChangeExtension(assembly.Location, ".xml") convention it uses for
      RevitAPI.xml in production (see DiscoveryReflector's own doc comment); a portable, self-contained
      fixture rather than depending on the real, Windows/Revit-install-only RevitAPI.dll being present in
      dev environments.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MCPBridge.Core\MCPBridge.Core.csproj" />
    <ProjectReference Include="..\..\src\MCPBridge.RevitAdapter\MCPBridge.RevitAdapter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hand-computed doc-id XML asset for direct XmlDocIndex parsing tests (option (a) in this feature's task brief); kept separate from the compiler-generated Fixtures/*.cs sidecar so XmlDocIndex's own parsing is exercised against a genuinely hand-authored file, not just the compiler's output. -->
    <None Include="Fixtures\SampleDocs.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
