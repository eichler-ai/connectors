<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted to match MCPBridge.Core itself (PRD §11). Reviewing this PR surfaced that the
         net8.0-windows leg ; the entire reason the multi-target exists ; had zero automated coverage:
         these tests only ever ran against the net10.0-windows build of Core. That is especially wrong
         for WireEnumNameConverter, which exists SPECIFICALLY because net8 lacks .NET 9+'s
         JsonStringEnumMemberNameAttribute, so the leg it was written for was the one leg never
         exercised. `dotnet test` now runs the whole suite once per TFM, which is what makes
         "byte-identical wire output on both legs" a claim CI can hold rather than one a live session
         confirmed once by hand. -->
    <TargetFrameworks>net10.0-windows;net8.0-windows</TargetFrameworks>
    <!--
      Multi-targeting these tests is the point: the net8.0-windows leg is the reason this project
      multi-targets at all, and WireEnumNameConverter exists precisely because net8's BCL lacks
      .NET 9+'s JsonStringEnumMemberNameAttribute.

      There is deliberately NO RollForward property here. An earlier version set
      RollForward=LatestMajor so the net8 assemblies could execute on the VM's only runtime (.NET
      10) ; that made `dotnet test` pass on both legs while running .NET 10's System.Text.Json
      TWICE, which is the one component whose net8/net10 difference this whole target exists for.
      It validated the net8 COMPILATION and nothing about net8 runtime behaviour.

      The VM now has the .NET 8 runtime (Microsoft.NETCore.App + Microsoft.WindowsDesktop.App
      8.0.30) alongside .NET 10, so the default roll-forward policy resolves the net8 leg to a real
      8.x runtime and the two legs genuinely differ. RuntimeTargetingTests asserts exactly that, per
      TFM, so this cannot silently regress if anyone reintroduces RollForward.

      Still exactly ONE SDK (see the skill's rule) ; a RUNTIME is not an SDK. Note the runtime
      installs to C:\Program Files\dotnet by default while the SDK lives in C:\dotnet10, and a
      .NET host only resolves frameworks from ITS OWN root (multi-level lookup was removed in
      .NET 7+), so the 8.0.30 framework folders were copied under C:\dotnet10\shared to be visible
      to the SDK's host. `dotnet ;;list-runtimes` (two hyphens ; MSB4025 forbids them in an XML
      comment) should show both 8.0.30 and 10.0.11.
    -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>MCPBridge.Core.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Revit-version mapping, mirroring MCPBridge.RevitAdapter.csproj / MCPBridge.Core.csproj (PRD §11). -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-windows'">
    <RevitVersion>2027</RevitVersion>
    <NiceRevitApiVersion>$(NiceRevitApiVersion_2027)</NiceRevitApiVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <RevitVersion>2025</RevitVersion>
    <NiceRevitApiVersion>$(NiceRevitApiVersion_2025)</NiceRevitApiVersion>
  </PropertyGroup>
  <PropertyGroup>
    <RevitInstallDir>C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallDir>
  </PropertyGroup>

  <!--
    There is deliberately NO <Reference Include="RevitAPI"> here, and that is load-bearing rather than
    an omission (PRD §14). RevitAPI.dll is a mixed-mode C++/CLI assembly that only Revit's own native
    host can load ; confirmed live on this dev VM, Assembly.LoadFrom on it anywhere else throws "An
    attempt was made to load a program with an incorrect format." Give THIS assembly a direct reference
    to it and xunit.runner.visualstudio cannot resolve that reference, SKIPS THE ENTIRE TEST ASSEMBLY,
    and `dotnet test` still exits 0: 300+ tests silently stop running while the build looks green.
    Measured both ways ; copy-local made no difference, the file was present and still unloadable.

    An INDIRECT reference is fine (this project references MCPBridge.RevitAdapter and MCPBridge.Core,
    both of which reference RevitAPI); it is specifically this assembly's own reference table that must
    stay clean. That is why the fakes implement plain IDocumentAdapter and NOT IRawDocumentSource ; see
    IRawDocumentSource's doc comment.

    Tests that need Revit types bindable from SCRIPT scope get them as Roslyn METADATA references
    instead, by file path ; Roslyn reads a mixed-mode assembly's managed metadata quite happily, it
    just cannot load it. Hence the paths below and RevitApiReference.cs.
  -->

  <!-- The per-TFM Revit assembly paths, so tests can hand Roslyn a metadata reference without
       hardcoding a Revit version. net10.0-windows resolves to 2027, net8.0-windows to 2025.
       RevitApiReference.cs reads these back and hard-fails if the file is missing.

       Normal build: the installed Revit assemblies. In CI (-p:UseNuGetRevitApi=true) there is no Revit
       install, so the MCPBridgeCoreTestsRevitApiNuGetPaths target below writes these same two metadata
       keys pointing at the restored Nice3point reference assemblies instead (issue #39). Roslyn only
       reads their managed metadata, exactly as it does the installed DLLs, so every compile-time check
       stays covered with no Revit present. -->
  <ItemGroup Condition="'$(UseNuGetRevitApi)' != 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RevitApiPath</_Parameter1>
      <_Parameter2>$(RevitInstallDir)\RevitAPI.dll</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RevitApiUiPath</_Parameter1>
      <_Parameter2>$(RevitInstallDir)\RevitAPIUI.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- CI-only: restore the Nice3point reference-assembly packages purely to obtain their on-disk paths.
       ExcludeAssets="all" is load-bearing: this project deliberately carries NO RevitAPI reference in its
       own reference table (see the big comment above the removed <Reference> block; a direct reference to
       the mixed-mode installed DLL makes xunit skip the entire assembly). These packages are restored for
       their DLL PATH only —handed to Roslyn as a metadata reference by RevitApiReference.cs —never
       compiled or referenced. GeneratePathProperty exposes $(Pkg...) for the target below. -->
  <ItemGroup Condition="'$(UseNuGetRevitApi)' == 'true'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(NiceRevitApiVersion)" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(NiceRevitApiVersion)" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <!-- Runs after restore (so $(Pkg...) is populated) and before the assembly-attribute generation that
       bakes AssemblyMetadata into the DLL, mirroring MCPBridge.AddIn's own BeforeTargets="GetAssemblyAttributes"
       targets. Globs each restored package for its RevitAPI(UI).dll under ref/ (Nice3point ships pure
       reference assemblies, so ref/ not lib/) —one hit per package, since each targets a single TFM
       (net8.0-windows7.0 for 2025, net10.0-windows7.0 for 2027) —and writes the
       RevitApiPath / RevitApiUiPath metadata RevitApiReference.cs expects. Fails loudly if a package layout
       change means the DLL isn't found, rather than baking an empty path that surfaces later as a confusing
       "built without RevitApiPath" test error. -->
  <Target Name="MCPBridgeCoreTestsRevitApiNuGetPaths"
          BeforeTargets="GetAssemblyAttributes"
          Condition="'$(UseNuGetRevitApi)' == 'true' And '$(TargetFramework)' != ''">
    <ItemGroup>
      <_RevitApiDll Include="$(PkgNice3point_Revit_Api_RevitAPI)/ref/**/RevitAPI.dll" />
      <_RevitApiUiDll Include="$(PkgNice3point_Revit_Api_RevitAPIUI)/ref/**/RevitAPIUI.dll" />
    </ItemGroup>
    <Error Condition="'@(_RevitApiDll)' == ''"
           Text="UseNuGetRevitApi is set but no RevitAPI.dll was found under '$(PkgNice3point_Revit_Api_RevitAPI)/ref'. Check the Nice3point.Revit.Api.RevitAPI package layout / version ($(NiceRevitApiVersion))." />
    <Error Condition="'@(_RevitApiUiDll)' == ''"
           Text="UseNuGetRevitApi is set but no RevitAPIUI.dll was found under '$(PkgNice3point_Revit_Api_RevitAPIUI)/ref'. Check the Nice3point.Revit.Api.RevitAPIUI package layout / version ($(NiceRevitApiVersion))." />
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>RevitApiPath</_Parameter1>
        <_Parameter2>@(_RevitApiDll)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>RevitApiUiPath</_Parameter1>
        <_Parameter2>@(_RevitApiUiDll)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MCPBridge.Core\MCPBridge.Core.csproj" />
    <ProjectReference Include="..\..\src\MCPBridge.RevitAdapter\MCPBridge.RevitAdapter.csproj" />
  </ItemGroup>

</Project>
